{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "include-v-in-release-name": true,
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore(testpypi): release${component} ${version}",
  "pull-request-header": "Merge this PR to publish to TestPyPI only. After verification, automation opens a separate PyPI promotion PR. Test the package before merging that second PR.",
  "packages": {
    ".": {
      "package-name": "vita-cv",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "vita/__init__.py"
        }
      ]
    }
  }
}
